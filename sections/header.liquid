{% style %}
  #shopify-section-{{ section.id }} .site-header {
    --header-bg:         {{ section.settings.background_color }};
    --header-link:       {{ section.settings.link_color }};
    --header-logo1:      {{ section.settings.logo_color_1 }};
    --header-logo2:      {{ section.settings.logo_color_2 }};
    --header-cart:       {{ section.settings.cart_color }};
    --header-logo-width: {{ section.settings.logo_max_width }}px;
  }
{% endstyle %}

{%- comment -%}
  Nav sits to the left of the centred logo by default (editorial masthead).
  Set "Navigation layout" to Split to balance links either side instead.
{%- endcomment -%}
{%- assign nav_links      = section.settings.menu.links -%}
{%- assign nav_link_count = nav_links.size -%}
{%- if section.settings.nav_alignment == 'split' -%}
  {%- assign left_count = nav_link_count | plus: 1 | divided_by: 2 -%}
{%- else -%}
  {%- assign left_count = nav_link_count -%}
{%- endif -%}

<div class="site-header-wrapper" id="site-header-wrapper">
  <header class="site-header{% if section.settings.nav_alignment == 'split' %} site-header--split{% endif %}" role="banner">

    {%- comment -%} Left zone: Desktop=nav links, Mobile=hamburger+search {%- endcomment -%}
    <div class="site-header__left">

      {%- comment -%} Desktop navigation {%- endcomment -%}
      <nav class="site-header__nav" aria-label="Main navigation">
        {% for link in nav_links limit: left_count %}
          <a
            href="{{ link.url }}"
            class="site-header__nav-link{% if link.active %} is-active{% endif %}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>

      {%- comment -%} Hamburger — mobile only {%- endcomment -%}
      <button
        class="site-header__burger"
        id="mobile-nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 18" fill="none" aria-hidden="true" focusable="false">
          <rect y="0"  width="24" height="2" rx="1" fill="currentColor"/>
          <rect y="8"  width="24" height="2" rx="1" fill="currentColor"/>
          <rect y="16" width="24" height="2" rx="1" fill="currentColor"/>
        </svg>
      </button>

    </div>

    {%- comment -%} Logo — always in center column {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo_image -%}
        {%- assign logo_2x = section.settings.logo_max_width | times: 2 -%}
        {%- assign logo_widths = section.settings.logo_max_width | append: ', ' | append: logo_2x -%}
        {%- assign logo_sizes = section.settings.logo_max_width | append: 'px' -%}
        {%- assign logo_alt = section.settings.logo_image.alt | default: shop.name -%}
        {{
          section.settings.logo_image
          | image_url: width: logo_2x
          | image_tag:
            class: 'site-header__logo-img',
            alt: logo_alt,
            loading: 'eager',
            widths: logo_widths,
            sizes: logo_sizes
        }}
      {%- else -%}
        <span class="logo-word-1">{{ section.settings.logo_text_1 }}</span>
        <span class="logo-word-2">{{ section.settings.logo_text_2 }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Right zone: second-half nav (desktop) + Search (desktop) + Account + Cart {%- endcomment -%}
    <div class="site-header__right">

      {%- comment -%} Right nav — desktop only, hidden on mobile via .site-header__nav rule {%- endcomment -%}
      <nav class="site-header__nav site-header__nav--right" aria-label="Main navigation secondary">
        {% for link in nav_links offset: left_count %}
          <a
            href="{{ link.url }}"
            class="site-header__nav-link{% if link.active %} is-active{% endif %}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>

      {%- comment -%} Icons group — account + cart {%- endcomment -%}
      <div class="site-header__icons">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="site-header__icon-link" aria-label="Account">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="site-header__icon-link site-header__cart-icon" aria-label="Cart, {{ cart.item_count }} items">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z"/>
          </svg>
          <span class="cart-icon__count{% if cart.item_count == 0 %} is-hidden{% endif %}" aria-live="polite">
            {{ cart.item_count }}
          </span>
        </a>
      </div>

    </div>

  </header>
</div>

{%- comment -%} Mobile navigation drawer — unchanged {%- endcomment -%}
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">

  <div class="mobile-nav__panel">
    {%- comment -%} Panel header {%- endcomment -%}
    <div class="mobile-nav__head">
      <a href="{{ routes.root_url }}" class="mobile-nav__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo_image -%}
          {%- assign mn_logo_2x = section.settings.logo_max_width | times: 2 -%}
          {%- assign mn_logo_alt = section.settings.logo_image.alt | default: shop.name -%}
          {{
            section.settings.logo_image
            | image_url: width: mn_logo_2x
            | image_tag:
              class: 'site-header__logo-img',
              alt: mn_logo_alt,
              loading: 'lazy'
          }}
        {%- else -%}
          <span class="logo-word-1">{{ section.settings.logo_text_1 }}</span>
          <span class="logo-word-2">{{ section.settings.logo_text_2 }}</span>
        {%- endif -%}
      </a>

      <button class="mobile-nav__close" id="mobile-nav-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Nav links {%- endcomment -%}
    <ul class="mobile-nav__links" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="mobile-nav__item">
          <a
            href="{{ link.url }}"
            class="mobile-nav__link{% if link.active %} is-active{% endif %}"
            {% if link.current %}aria-current="page"{% endif %}
          >{{ link.title }}</a>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%} Bottom actions {%- endcomment -%}
    <div class="mobile-nav__foot">
      <a href="{{ routes.cart_url }}" class="mobile-nav__cart">
        {{ section.settings.cart_label }}
        {%- if cart.item_count > 0 -%}
          <span class="mobile-nav__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="mobile-nav__account">
          {{ section.settings.account_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="mobile-nav__backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>
</nav>

{% stylesheet %}
  .site-header-wrapper {
    background: var(--header-bg, #ffffff);
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 0.35s ease;
    height: var(--nav-height, 72px);
  }

  .site-header-wrapper.is-scrolled {
    border-bottom-color: rgba(45, 58, 24, 0.16);
  }

  /* 3-column grid: left | center (logo) | right */
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  /* Left zone */
  .site-header__left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Right zone */
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-content: flex-end;
  }

  /* Logo — serif wordmark, generously tracked */
  .site-header__logo {
    text-transform: uppercase;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0.08em;
    display: flex;
    align-items: baseline;
    gap: 0.28em;
    line-height: 1;
    flex-shrink: 0;
  }

  .logo-word-1 { color: var(--header-logo1, #2d3a18); }
  .logo-word-2 { color: var(--header-logo2, #2d3a18); }

  .site-header__logo-img {
    display: block;
    width: auto;
    max-width: var(--header-logo-width, 150px);
    max-height: calc(var(--nav-height, 72px) - 28px);
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .site-header__logo { font-size: 20px; }
    .site-header__logo-img {
      max-width: calc(var(--header-logo-width, 150px) * 0.8);
    }
  }

  /* Desktop nav links — extended grotesque micro-caps */
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .site-header__nav-link {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--header-link, #2d3a18);
    text-decoration: none;
    position: relative;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.25s ease;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link.is-active::after {
    width: 100%;
  }

  /* Icon links (account + cart) */
  .site-header__icon-link {
    color: var(--header-cart, #2d3a18);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .site-header__icon-link:hover { opacity: 0.6; }

  .site-header__icon-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    display: block;
  }

  /* Cart icon uses stroke, not fill */
  .site-header__cart-icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  /* Count sits beside the bag as a plain numeral, not a coloured pip */
  .cart-icon__count {
    position: absolute;
    top: -4px;
    right: -10px;
    background: transparent;
    color: var(--color-tan);
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0;
    min-width: auto;
    height: auto;
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
    pointer-events: none;
  }

  .cart-icon__count.is-hidden { display: none; }

  /* Hamburger button */
  .site-header__burger {
    background: none;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 6px 4px;
    line-height: 0;
    flex-shrink: 0;
    transition: opacity 0.2s;
    display: none;
  }

  .site-header__burger:hover { opacity: 0.6; }

  .site-header__burger svg {
    width: 22px;
    height: 16px;
    display: block;
  }

  /* Mobile: hide desktop nav, show hamburger */
  @media (max-width: 1024px) {
    .site-header__nav    { display: none; }
    .site-header__burger { display: flex; align-items: center; }
  }

  /* =====================
     Mobile Navigation
     ===================== */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 1000;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-nav.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  /* Backdrop */
  .mobile-nav__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(45, 58, 24, 0.35);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .mobile-nav.is-open .mobile-nav__backdrop {
    opacity: 1;
  }

  /* Slide-in panel */
  .mobile-nav__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(360px, 88vw);
    background: var(--color-paper);
    border-right: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .mobile-nav.is-open .mobile-nav__panel {
    transform: translateX(0);
  }

  /* Panel header */
  .mobile-nav__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 28px;
    border-bottom: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  .mobile-nav__logo {
    text-transform: uppercase;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.08em;
    display: flex;
    align-items: baseline;
    gap: 0.28em;
    line-height: 1;
  }

  /* Close button */
  .mobile-nav__close {
    background: none;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 6px;
    line-height: 0;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .mobile-nav__close:hover { opacity: 0.6; }

  .mobile-nav__close svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* Nav links */
  .mobile-nav__links {
    list-style: none;
    padding: 12px 0;
    margin: 0;
    flex: 1;
  }

  .mobile-nav__item {
    border-bottom: 1px solid var(--color-rule);
  }

  .mobile-nav__link {
    display: block;
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink);
    text-decoration: none;
    padding: 18px 28px;
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.3s ease, transform 0.3s ease, padding-left 0.2s ease;
  }

  .mobile-nav.is-open .mobile-nav__link {
    opacity: 1;
    transform: translateX(0);
  }

  /* Stagger link animations */
  .mobile-nav__item:nth-child(1) .mobile-nav__link { transition-delay: 0.08s; }
  .mobile-nav__item:nth-child(2) .mobile-nav__link { transition-delay: 0.13s; }
  .mobile-nav__item:nth-child(3) .mobile-nav__link { transition-delay: 0.18s; }
  .mobile-nav__item:nth-child(4) .mobile-nav__link { transition-delay: 0.23s; }
  .mobile-nav__item:nth-child(5) .mobile-nav__link { transition-delay: 0.28s; }
  .mobile-nav__item:nth-child(6) .mobile-nav__link { transition-delay: 0.33s; }

  .mobile-nav__link:hover,
  .mobile-nav__link.is-active {
    padding-left: 36px;
  }

  /* Panel footer — cart + account */
  .mobile-nav__foot {
    padding: 24px 28px 32px;
    border-top: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
  }

  .mobile-nav__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-ink);
    text-decoration: none;
    border: 1px solid var(--color-ink);
    padding: 13px 22px;
    transition: opacity 0.2s;
    align-self: stretch;
  }

  .mobile-nav__cart:hover { opacity: 0.8; }

  .mobile-nav__cart-count {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    font-weight: 500;
    min-width: auto;
    height: auto;
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .mobile-nav__account {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-60);
    text-decoration: none;
    transition: color 0.2s;
    align-self: center;
  }

  .mobile-nav__account:hover { color: var(--color-ink); }

  /* Only show on mobile */
  @media (min-width: 1025px) {
    .mobile-nav { display: none; }
  }

  /* =====================
     Icons group wrapper
     ===================== */
  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  /* =====================
     Desktop nav placement
     ===================== */
  @media (min-width: 1025px) {
    /* Left-aligned layout: links hug the left edge of the masthead */
    .site-header__left .site-header__nav {
      justify-content: flex-start;
    }

    .site-header__nav--right {
      justify-content: flex-end;
    }

    /* Split layout: spread each half across its own column so the two groups
       sit symmetrically about the logo. Packing them to the outer edges reads
       lopsided, because only the right column also carries the icons. */
    .site-header--split .site-header__left .site-header__nav {
      width: 100%;
      justify-content: space-evenly;
      gap: 0;
    }

    .site-header--split .site-header__nav--right {
      flex: 1;
      justify-content: space-evenly;
      gap: 0;
    }

    /* Right nav is empty in the default (left-aligned) layout */
    .site-header__nav--right:empty { display: none; }
  }
{% endstylesheet %}

{% javascript %}
(function () {
  var wrapper = document.getElementById('site-header-wrapper');

  // Our own fixed wrapper around the header group (see layout/theme.liquid).
  var group = document.getElementById('site-header-fixed');

  // Size the in-flow spacer to match the fixed header's exact height.
  var spacer = document.getElementById('header-spacer');
  function sizeSpacer() {
    if (spacer && group) spacer.style.height = group.offsetHeight + 'px';
  }
  sizeSpacer();
  window.addEventListener('load', sizeSpacer);
  window.addEventListener('resize', sizeSpacer, { passive: true });

  // Scroll-shadow + hide-on-scroll-down / reveal-on-scroll-up
  var announcementBar = document.querySelector('.announcement-bar');
  var abHeight = announcementBar ? announcementBar.offsetHeight : 42;
  var lastY = window.scrollY;
  var ticking = false;

  function onScroll() {
    var y = window.scrollY;

    // Solid backdrop once past the announcement bar
    if (wrapper) wrapper.classList.toggle('is-scrolled', y > abHeight);

    if (group) {
      // Reveal on ANY upward movement, anywhere on the page.
      if (y < lastY) {
        group.classList.remove('header-group--hidden');
      // Hide only when scrolling down past the announcement bar.
      } else if (y > lastY && y > abHeight + 80) {
        group.classList.add('header-group--hidden');
      }

      // Always show at the very top.
      if (y <= abHeight) group.classList.remove('header-group--hidden');
    }

    lastY = y;
    ticking = false;
  }

  window.addEventListener('scroll', function () {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });

  // Mobile nav
  var nav      = document.getElementById('mobile-nav');
  var toggle   = document.getElementById('mobile-nav-toggle');
  var close    = document.getElementById('mobile-nav-close');
  var backdrop = document.getElementById('mobile-nav-backdrop');
  if (!nav || !toggle) return;

  function openNav() {
    nav.classList.add('is-open');
    nav.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.documentElement.setAttribute('scroll-lock', '');
    // Focus the close button for accessibility
    if (close) setTimeout(function () { close.focus(); }, 50);
  }

  function closeNav() {
    nav.classList.remove('is-open');
    nav.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.documentElement.removeAttribute('scroll-lock');
    toggle.focus();
  }

  toggle.addEventListener('click', openNav);
  if (close)    close.addEventListener('click', closeNav);
  if (backdrop) backdrop.addEventListener('click', closeNav);

  // Close on Escape key
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) closeNav();
  });

  // Close when a nav link is tapped
  nav.querySelectorAll('.mobile-nav__link, .mobile-nav__cart, .mobile-nav__logo').forEach(function (el) {
    el.addEventListener('click', closeNav);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "When set, replaces the text logo. Use a PNG with transparent background for best results."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max-width",
      "min": 60,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "text",
      "id": "logo_text_1",
      "label": "Logo — first word (fallback)",
      "default": "RUCK",
      "info": "Shown when no logo image is uploaded"
    },
    {
      "type": "text",
      "id": "logo_text_2",
      "label": "Logo — second word (fallback)",
      "default": "ON",
      "info": "Shown when no logo image is uploaded"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "nav_alignment",
      "label": "Navigation layout",
      "options": [
        { "value": "left", "label": "All links left of logo" },
        { "value": "split", "label": "Split either side of logo" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Cart"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart button label",
      "default": "Cart"
    },
