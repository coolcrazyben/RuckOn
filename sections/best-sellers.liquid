{% style %}
  #shopify-section-{{ section.id }} .best-sellers {
    --bs-bg:           {{ section.settings.background_color }};
    --bs-eyebrow:      {{ section.settings.eyebrow_color }};
    --bs-heading:      {{ section.settings.heading_color }};
    --bs-accent:       {{ section.settings.accent_color }};
    --bs-badge-bg:     {{ section.settings.badge_bg_color }};
    --bs-badge-text:   {{ section.settings.badge_text_color }};
  }
{% endstyle %}

{%- liquid
  assign featured_collection = collections[section.settings.collection]
  if featured_collection == empty or featured_collection == nil
    assign featured_collection = collections.frontpage
  endif
  assign product_limit = section.settings.product_limit | default: 6
-%}

<div class="best-sellers">
  <div class="best-sellers__header">
    <div class="best-sellers__header-left">
      {%- if section.settings.eyebrow_text != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow_text }}</span>
      {%- endif -%}
      <h2 class="best-sellers__title">
        {{ section.settings.heading_text_1 }}
        {%- if section.settings.heading_text_2 != blank -%}
          <span>{{ section.settings.heading_text_2 }}</span>
        {%- endif -%}
      </h2>
    </div>
    {%- if section.settings.view_all_text != blank and featured_collection != empty -%}
      <a href="{{ featured_collection.url }}" class="best-sellers__view-all">
        {{ section.settings.view_all_text }} &rarr;
      </a>
    {%- endif -%}
  </div>

  {%- if featured_collection != empty and featured_collection.products.size > 0 -%}
    <div class="best-sellers__grid">
      {%- for product in featured_collection.products limit: product_limit -%}
        <article
          class="product-card fade-up"
          data-delay="{{ forloop.index }}"
        >
          <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title }}">
            <div class="product-card__media">
              {%- render 'product-card-media',
                product: product,
                image_width: 800,
                sizes: '(max-width: 768px) 50vw, 33vw'
              -%}
            </div>

            <div class="product-card__overlay"></div>

            <div class="product-card__info">
              {%- if section.settings.show_badge and product.type != blank -%}
                <span class="product-card__badge">{{ product.type }}</span>
              {%- endif -%}

              <h3 class="product-card__title">{{ product.title }}</h3>

              {%- assign card_variant = product.variants.first -%}
              <p class="product-card__price">
                {%- if card_variant.compare_at_price > card_variant.price -%}
                  <s class="product-card__compare">{{ card_variant.compare_at_price | money }}</s>
                {%- endif -%}
                {{ card_variant.price | money }}
              </p>

              <span class="product-card__cta" aria-hidden="true">
                {{ section.settings.card_cta_text }} &rarr;
              </span>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="best-sellers__empty">{{ section.settings.empty_text }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .best-sellers {
    background-color: var(--bs-bg, #ffffff);
    padding: 96px var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
    width: 100%;
  }

  /* Section header */
  /* Centred masthead with the view-all sitting underneath, editorial style */
  .best-sellers__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 44px;
    gap: 16px;
  }

  .best-sellers__title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--bs-heading, #0a1e32);
  }

  .best-sellers__title span {
    color: inherit;
    font-style: italic;
  }

  .best-sellers__view-all {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bs-accent, #857151);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid currentcolor;
    padding-bottom: 2px;
    opacity: 0.75;
    transition: opacity 0.2s;
  }

  .best-sellers__view-all:hover { opacity: 1; }

  /* Product grid */
  .best-sellers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto;
    column-gap: 24px;
    row-gap: 48px;
  }

  /* All cards uniform size — no spanning */
  .best-sellers__grid .product-card {
    align-self: start;
  }

  /* product-card base styles live in critical.css */

  .best-sellers__empty {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-navy-60);
    text-align: center;
    padding: 60px 0;
  }

  @media (max-width: 1024px) {
    .best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .best-sellers {
      padding: 60px var(--page-margin);
    }
    .best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 12px;
      row-gap: 32px;
    }
    /* product-card height is driven by aspect-ratio, no min-height needed */
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow label",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "heading_text_1",
      "label": "Heading — first part (white)",
      "default": "Best "
    },
    {
      "type": "text",
      "id": "heading_text_2",
      "label": "Heading — second part (tan accent)",
      "default": "Sellers"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display",
      "info": "If empty, falls back to the frontpage collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 3,
      "max": 9,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show product type badge",
      "default": true
    },
    {
      "type": "text",
      "id": "card_cta_text",
      "label": "Card hover CTA text",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when no products found",
      "default": "No products found — add some to this collection."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#857151"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0a1e32"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / price color",
      "default": "#9a825c"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#857151"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#0a1e32"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
