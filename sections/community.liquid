      "default": "Join the Community"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Background image (larger)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Foreground image (smaller, overlapping)"
