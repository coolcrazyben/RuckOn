{% style %}
  #shopify-section-{{ section.id }} {
    --hero-eyebrow-color:   {{ section.settings.eyebrow_color }};
    --hero-headline1-color: {{ section.settings.headline1_color }};
    --hero-headline2-color: {{ section.settings.headline2_color }};
    --hero-subtext-color:   {{ section.settings.subtext_color }};
    --hero-min-height:      {{ section.settings.min_height }}px;
  }
{% endstyle %}

{%- comment -%}
  Background media is a slideshow of blocks (image or video). If no blocks are
  added, we fall back to the legacy single background_image so existing hero
  instances keep working untouched.
{%- endcomment -%}
{%- assign slide_count = section.blocks.size -%}

<div
  class="hero full-width"
  data-hero
  data-autoplay="{{ section.settings.autoplay_speed }}"
>
  <div class="hero__media">
    {%- if slide_count > 0 -%}
      {%- for block in section.blocks -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'video' -%}
              {%- if block.settings.video != blank -%}
                {%- assign hero_poster = block.settings.poster | default: block.settings.video.preview_image -%}
                <video
                  class="hero__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 2400 }}"{% endif %}
                >
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif block.settings.poster != blank -%}
                {{
                  block.settings.poster
                  | image_url: width: 2400
                  | image_tag: loading: 'lazy', sizes: '100vw', alt: block.settings.poster.alt
                }}
              {%- endif -%}
            {%- else -%}
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    sizes: '100vw',
                    alt: block.settings.image.alt
                }}
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- elsif section.settings.background_image != blank -%}
      <div class="hero__slide is-active" data-slide="0">
        {{
          section.settings.background_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            alt: section.settings.background_image.alt
        }}
      </div>
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>
  <div class="hero__grid"></div>

  <div class="hero__content">
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="hero__eyebrow fade-up" data-delay="1">
        {{ section.settings.eyebrow_text }}
      </p>
    {%- endif -%}

    <h1 class="hero__headline">
      {%- if section.settings.headline_line1 != blank -%}
        <span class="hero__headline-1 fade-up" data-delay="2">
          {{- section.settings.headline_line1 -}}
        </span>
      {%- endif -%}
      {%- if section.settings.headline_line2 != blank -%}
        <span class="hero__headline-2 fade-up" data-delay="3">
          {{- section.settings.headline_line2 -}}
        </span>
      {%- endif -%}
    </h1>

    {%- if section.settings.subtext != blank -%}
      <p class="hero__subtext fade-up" data-delay="4">
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    <div class="hero__buttons fade-up" data-delay="5">
      {%- if section.settings.btn_primary_text != blank -%}
        <a href="{{ section.settings.btn_primary_url | default: '#' }}" class="btn btn--primary">
          {{ section.settings.btn_primary_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_secondary_text != blank -%}
        <a href="{{ section.settings.btn_secondary_url | default: '#' }}" class="btn btn--outline-light">
          {{ section.settings.btn_secondary_text }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if slide_count > 1 -%}
    <div class="hero__dots" role="tablist" aria-label="Hero slides">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="hero__dot{% if forloop.first %} is-active{% endif %}"
          data-dot="{{ forloop.index0 }}"
          aria-label="Show slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero__scroll" aria-hidden="true">
      <span class="hero__scroll-line"></span>
      <span class="hero__scroll-label">Scroll</span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .hero {
    position: relative;
    min-height: max(92svh, var(--hero-min-height, 700px));
    background-color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Background media / slideshow */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__slide img,
  .hero__slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* A quiet scrim — just enough to hold type, never enough to dull the photo */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top,
        rgba(45, 58, 24, 0.45) 0%,
        rgba(45, 58, 24, 0.18) 45%,
        rgba(45, 58, 24, 0.28) 100%
      );
  }

  /* Retired with the tactical treatment; kept so existing markup stays valid */
  .hero__grid { display: none; }

  /* Content — centred masthead */
  .hero__content {
    position: relative;
    z-index: 3;
    padding: clamp(64px, 10vh, 140px) clamp(24px, 5vw, 80px);
    max-width: 900px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__eyebrow {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--hero-eyebrow-color, rgba(255, 255, 255, 0.78));
    margin-bottom: 1.5rem;
  }

  .hero__headline {
    font-family: var(--font-heading);
    font-size: clamp(52px, 7.2vw, 104px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0.01em;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero__headline-1 {
    color: var(--hero-headline1-color, #ffffff);
    display: block;
  }

  /* The second line carries the house italic */
  .hero__headline-2 {
    color: var(--hero-headline2-color, #ffffff);
    display: block;
  }

  .hero__subtext {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    color: var(--hero-subtext-color, rgba(255, 255, 255, 0.88));
    max-width: 46ch;
    line-height: 1.6;
    margin: 0 auto 2.25rem;
  }

  .hero__buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Slideshow dots */
  .hero__dots {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 10px;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.8);
    background: transparent;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .hero__dot.is-active { background: #fff; }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 36px;
    right: clamp(20px, 4vw, 60px);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.8));
    animation: scroll-pulse 2.4s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 0; }
    50%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  .hero__scroll-label {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    writing-mode: vertical-rl;
  }

  @media (max-width: 768px) {
    .hero__scroll { display: none; }
    .hero__headline { font-size: clamp(40px, 11vw, 68px); }
    .hero__buttons { width: 100%; flex-direction: column; align-items: center; }
    .hero__buttons .btn { width: min(280px, 100%); }
  }
{% endstylesheet %}

{% javascript %}
(function () {
  function initHero(hero) {
    var slides = hero.querySelectorAll('.hero__slide');
    if (slides.length < 2) return; // nothing to rotate

    var dots  = hero.querySelectorAll('.hero__dot');
    var speed = (parseInt(hero.getAttribute('data-autoplay'), 10) || 6) * 1000;
    var index = 0;
    var timer = null;

    function show(i) {
      index = (i + slides.length) % slides.length;
      slides.forEach(function (s, n) { s.classList.toggle('is-active', n === index); });
      dots.forEach(function (d, n) { d.classList.toggle('is-active', n === index); });
    }

    function next() { show(index + 1); }

    function start() {
      if (speed > 0) {
        stop();
        timer = setInterval(next, speed);
      }
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        show(parseInt(dot.getAttribute('data-dot'), 10));
        start(); // restart the clock after a manual pick
      });
    });

    // Pause when the hero is off-screen to save cycles
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.isIntersecting ? start() : stop(); });
      }, { threshold: 0.1 }).observe(hero);
    } else {
      start();
    }
  }

  document.querySelectorAll('[data-hero]').forEach(initHero);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Hero",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "image",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Uploaded video. Autoplays muted and loops as a background."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Shown while the video loads (and as a fallback)."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "paragraph",
      "content": "Add Image and Video slides as blocks below. They rotate as a slideshow. If no blocks are added, the single fallback image below is used."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6,
      "info": "Only applies when there is more than one slide."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Fallback background image",
      "info": "Used only when no Image/Video slide blocks are added."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum section height",
      "min": 500,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Autumn Collection"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline — line 1 (roman)",
      "default": "Carry the"
    },
    {
      "type": "color",
      "id": "headline1_color",
      "label": "Headline line 1 color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline — line 2 (italic)",
      "default": "Weight"
    },
    {
      "type": "color",
      "id": "headline2_color",
      "label": "Headline line 2 color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Subtext"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext paragraph",
      "default": "Built for the miles that ask more of you."
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary button URL"
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
