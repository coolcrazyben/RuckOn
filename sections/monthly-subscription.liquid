      "default": "How It Works"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#7a6634"
    },
    {
      "type": "color",
      "id": "heading_color_1",
      "label": "Heading line 1 color",
      "default": "#2d3a18"
    },
    {
      "type": "color",
      "id": "heading_color_2",
      "label": "Heading line 2 color",
      "default": "#7a6634"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#5f6653"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#7a6634"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (card top border, step number)",
      "default": "#7a6634"
    },
    {
      "type": "color",
      "id": "step_number_color",
      "label": "Step number text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#f6f6f3"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#2d3a18"
    },
    {
      "type": "color",
      "id": "card_body_color",
      "label": "Card body color",
      "default": "#5f6653"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
