{% style %}
  #shopify-section-{{ section.id }} .site-footer {
    --ft-bg:           {{ section.settings.background_color }};
    --ft-border:       {{ section.settings.top_border_color }};
    --ft-logo1:        {{ section.settings.logo_color_1 }};
    --ft-logo2:        {{ section.settings.logo_color_2 }};
    --ft-tagline:      {{ section.settings.tagline_color }};
    --ft-col-title:    {{ section.settings.column_title_color }};
    --ft-link:         {{ section.settings.link_color }};
    --ft-bottom-text:  {{ section.settings.bottom_text_color }};
  }
{% endstyle %}

<footer class="site-footer full-width" role="contentinfo">
  <div class="site-footer__main">

    {%- comment -%} Column 1: Brand {%- endcomment -%}
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name }}">
        <span class="ft-logo-1">{{ section.settings.logo_text_1 }}</span>
        <span class="ft-logo-2">{{ section.settings.logo_text_2 }}</span>
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.address != blank -%}
        <p class="site-footer__address">{{ section.settings.address | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.show_payment_icons -%}
        <div class="site-footer__payment" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Columns 2–4: Link menus {%- endcomment -%}
    {%- assign col_indices = '1,2,3' | split: ',' -%}
    {%- for i in col_indices -%}
      {%- assign title_key = 'col' | append: i | append: '_title' -%}
      {%- assign menu_key  = 'col' | append: i | append: '_menu'  -%}
      {%- assign col_title = section.settings[title_key] -%}
      {%- assign col_menu  = section.settings[menu_key]  -%}

      <div class="site-footer__col">
        {%- if col_title != blank -%}
          <h3 class="site-footer__col-title">{{ col_title }}</h3>
        {%- endif -%}
        {%- if col_menu.links.size > 0 -%}
          <ul class="site-footer__links" role="list">
            {%- for link in col_menu.links -%}
              <li>
                <a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}

  </div>

  {%- assign has_social = false -%}
  {%- if section.settings.social_instagram != blank
     or section.settings.social_facebook != blank
     or section.settings.social_youtube != blank
     or section.settings.social_strava != blank -%}
    {%- assign has_social = true -%}
  {%- endif -%}

  {%- if has_social -%}
    <div class="site-footer__social-row">
      <span class="site-footer__social-label">{{ section.settings.social_label }}</span>
      <ul class="site-footer__social" role="list">
        {%- if section.settings.social_instagram != blank -%}
          <li><a href="{{ section.settings.social_instagram }}" class="site-footer__social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a></li>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
          <li><a href="{{ section.settings.social_facebook }}" class="site-footer__social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
              <path d="M14.5 8.5h2.2V5.6h-2.4c-2.3 0-3.6 1.4-3.6 3.6v1.7H8.5v2.9h2.2V21h3v-7.2h2.3l.4-2.9h-2.7V9.5c0-.7.3-1 1-1Z"/>
            </svg>
          </a></li>
        {%- endif -%}
        {%- if section.settings.social_youtube != blank -%}
          <li><a href="{{ section.settings.social_youtube }}" class="site-footer__social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
              <rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/>
              <path d="M10.3 9.6v4.8l4.2-2.4-4.2-2.4Z" fill="currentColor" stroke="none"/>
            </svg>
          </a></li>
        {%- endif -%}
        {%- if section.settings.social_strava != blank -%}
          <li><a href="{{ section.settings.social_strava }}" class="site-footer__social-link" aria-label="Strava">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M10.6 2 5 13.1h3.3L10.6 8.5l2.3 4.6h3.3L10.6 2Zm3.6 11.1-1.7 3.4-1.7-3.4H8.2L12.5 22l4.3-8.9h-2.6Z"/>
            </svg>
          </a></li>
        {%- endif -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="site-footer__bottom">
    <p class="site-footer__copy">
      &copy; {{ 'now' | date: '%Y' }}
      <a href="{{ routes.root_url }}">{{ shop.name }}</a>.
      {{ section.settings.copyright_suffix }}
    </p>
    {%- if section.settings.footer_tagline != blank -%}
      <p class="site-footer__motto">{{ section.settings.footer_tagline }}</p>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background-color: var(--ft-bg, #ffffff);
    border-top: 1px solid var(--ft-border, #e7e9eb);
    padding: 80px var(--page-margin) 0;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    max-width: var(--page-width);
    margin: 0 auto;
    padding-bottom: 56px;
  }

  /* Brand column */
  .site-footer__logo {
    text-transform: uppercase;
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.14em;
    margin-bottom: 16px;
  }

  .ft-logo-1 { color: var(--ft-logo1, #0a1e32); }
  .ft-logo-2 { color: var(--ft-logo2, #0a1e32); }

  .site-footer__tagline {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--ft-tagline, #5c6469);
    line-height: 1.65;
    max-width: 34ch;
  }

  .site-footer__address {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ft-tagline, #5c6469);
    line-height: 1.7;
    margin-top: 18px;
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .payment-icon {
    height: 22px;
    width: auto;
    opacity: 0.55;
    filter: grayscale(1);
  }

  /* Link columns */
  .site-footer__col-title {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ft-col-title, #0a1e32);
    margin-bottom: 22px;
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--ft-link, #5c6469);
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.4;
  }

  .site-footer__link:hover { color: var(--color-navy); }

  /* Social row */
  .site-footer__social-row {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 28px 0;
    border-top: 1px solid var(--color-rule);
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .site-footer__social-label {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .site-footer__social {
    list-style: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .site-footer__social-link {
    color: var(--color-navy);
    display: block;
    transition: opacity 0.2s ease;
  }

  .site-footer__social-link:hover { opacity: 0.6; }

  .site-footer__social-link svg {
    width: 19px;
    height: 19px;
    display: block;
  }

  /* Bottom bar */
  .site-footer__bottom {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 22px 0 32px;
    border-top: 1px solid var(--color-rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .site-footer__copy,
  .site-footer__motto {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ft-bottom-text, #5c6469);
  }

  .site-footer__copy a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .site-footer__main {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .site-footer { padding-top: 56px; }

    .site-footer__main {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
{% endstylesheet %}

