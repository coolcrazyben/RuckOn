{% style %}
  #shopify-section-{{ section.id }} .categories {
    --cat-bg:          {{ section.settings.background_color }};
    --cat-eyebrow:     {{ section.settings.eyebrow_color }};
    --cat-heading:     {{ section.settings.heading_color }};
    --cat-accent:      {{ section.settings.accent_color }};
    --cat-card-text:   {{ section.settings.card_text_color }};
    --cat-columns:     {{ section.blocks.size | at_most: 4 | at_least: 1 }};
  }
{% endstyle %}

<div class="categories">
  <div class="categories__header">
    {%- if section.settings.eyebrow_text != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow_text }}</span>
    {%- endif -%}
    <h2 class="categories__title">
      {{ section.settings.heading_text_1 }}
      {%- if section.settings.heading_text_2 != blank -%}
        <span>{{ section.settings.heading_text_2 }}</span>
      {%- endif -%}
    </h2>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="categories__grid">
      {%- for block in section.blocks -%}
        {%- assign cat_url = block.settings.link_url | default: '#' -%}
        {%- if block.settings.collection != blank -%}
          {%- assign linked_collection = collections[block.settings.collection] -%}
          {%- if linked_collection != empty -%}
            {%- assign cat_url = linked_collection.url -%}
          {%- endif -%}
        {%- endif -%}

        <a
          href="{{ cat_url }}"
          class="category-card fade-up"
          data-delay="{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <div class="category-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(max-width: 768px) 50vw, 25vw',
                  alt: block.settings.category_name
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-card__placeholder' }}
            {%- endif -%}
          </div>

          <div class="category-card__overlay" style="--card-gradient: {{ block.settings.gradient_overlay }};"></div>

          <div class="category-card__info">
            {%- if block.settings.category_name != blank -%}
              <h3 class="category-card__name">{{ block.settings.category_name }}</h3>
            {%- endif -%}
            {%- if block.settings.product_count != blank -%}
              <p class="category-card__count">{{ block.settings.product_count }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .categories {
    background-color: var(--cat-bg, #ffffff);
    padding: 96px var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
    width: 100%;
  }

  .categories__header {
    margin-bottom: 44px;
    text-align: center;
  }

  .categories__title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--cat-heading, #2d3a18);
  }

  .categories__title span {
    color: var(--color-tan);
  }

  /* Grid */
  .categories__grid {
    display: grid;
    grid-template-columns: repeat(var(--cat-columns, 4), 1fr);
    gap: 8px;
  }

  /* Card */
  .category-card {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    text-decoration: none;
    display: block;
    background-color: var(--color-paper-cool);
  }

  .category-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .category-card__media img,
  .category-card__media .category-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .category-card:hover .category-card__media img { transform: scale(1.035); }

  .category-card__overlay {
    position: absolute;
    inset: 0;
    background: var(--card-gradient, linear-gradient(to top, rgba(45, 58, 24,0.85) 0%, rgba(45, 58, 24,0.2) 60%, transparent 100%));
    z-index: 1;
  }

  .category-card__info {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 32px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    gap: 14px;
  }

  .category-card__name {
    font-family: var(--font-heading);
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 600;
    line-height: 1.05;
    color: var(--cat-card-text, #ffffff);
    overflow-wrap: normal;
    word-break: normal;
  }

  /* Reads as the house stroke link sitting under the tile name */
  .category-card__count {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }

  .category-card:hover .category-card__count { border-bottom-color: #ffffff; }

  @media (max-width: 1024px) {
    .categories__grid {
      grid-template-columns: repeat(min(var(--cat-columns, 4), 2), 1fr);
    }
  }

  @media (max-width: 768px) {
    .categories { padding: 64px var(--page-margin); }
    .categories__grid { grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .category-card__name { font-size: clamp(18px, 5vw, 26px); }
  }
{% endstylesheet %}

