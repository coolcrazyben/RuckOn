{% style %}
  #shopify-section-{{ section.id }} .about-hero {
    --about-hero-height:   {{ section.settings.hero_min_height }}px;
    --about-hero-eyebrow:  {{ section.settings.hero_eyebrow_color }};
    --about-hero-hl1:      {{ section.settings.hero_hl1_color }};
    --about-hero-hl2:      {{ section.settings.hero_hl2_color }};
    --about-hero-body:     {{ section.settings.hero_body_color }};
  }
  #shopify-section-{{ section.id }} .about-story {
    --about-story-bg:      {{ section.settings.story_bg }};
    --about-story-eyebrow: {{ section.settings.story_eyebrow_color }};
    --about-story-hl:      {{ section.settings.story_heading_color }};
    --about-story-accent:  {{ section.settings.story_accent_color }};
    --about-story-body:    {{ section.settings.story_body_color }};
    --about-story-year:    {{ section.settings.story_year_color }};
  }
  #shopify-section-{{ section.id }} .about-values {
    --about-values-bg:      {{ section.settings.values_bg }};
    --about-values-eyebrow: {{ section.settings.values_eyebrow_color }};
    --about-values-hl:      {{ section.settings.values_heading_color }};
    --about-values-card-bg: {{ section.settings.values_card_bg }};
    --about-values-num:     {{ section.settings.values_num_color }};
    --about-values-title:   {{ section.settings.values_title_color }};
    --about-values-body:    {{ section.settings.values_body_color }};
  }
  #shopify-section-{{ section.id }} .about-mission {
    --about-mission-bg:      {{ section.settings.mission_bg }};
    --about-mission-ql1:     {{ section.settings.mission_ql1_color }};
    --about-mission-ql2:     {{ section.settings.mission_ql2_color }};
    --about-mission-body:    {{ section.settings.mission_body_color }};
    --about-mission-divider: {{ section.settings.mission_divider_color }};
  }
  #shopify-section-{{ section.id }} .about-stats {
    --about-stats-bg:      {{ section.settings.stats_bg }};
    --about-stats-number:  {{ section.settings.stats_number_color }};
    --about-stats-label:   {{ section.settings.stats_label_color }};
    --about-stats-divider: {{ section.settings.stats_divider_color }};
  }
  #shopify-section-{{ section.id }} .about-cta {
    --about-cta-bg:      {{ section.settings.cta_bg }};
    --about-cta-eyebrow: {{ section.settings.cta_eyebrow_color }};
    --about-cta-hl:      {{ section.settings.cta_heading_color }};
    --about-cta-body:    {{ section.settings.cta_body_color }};
  }
{% endstyle %}

{%- comment -%}——— HERO ———{%- endcomment -%}
<div class="about-hero full-width">
  {%- if section.settings.hero_image != blank -%}
    <div class="about-hero__bg">
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          alt: section.settings.hero_image.alt
      }}
    </div>
  {%- endif -%}

  <div class="about-hero__overlay"></div>
  <div class="about-hero__grid"></div>

  <div class="about-hero__content">
    {%- if section.settings.hero_eyebrow != blank -%}
      <p class="about-hero__eyebrow fade-up" data-delay="1">{{ section.settings.hero_eyebrow }}</p>
    {%- endif -%}

    <h1 class="about-hero__headline">
      {%- if section.settings.hero_hl1 != blank -%}
        <span class="about-hero__hl1 fade-up" data-delay="2">{{ section.settings.hero_hl1 }}</span>
      {%- endif -%}
      {%- if section.settings.hero_hl2 != blank -%}
        <span class="about-hero__hl2 fade-up" data-delay="3">{{ section.settings.hero_hl2 }}</span>
      {%- endif -%}
    </h1>

    {%- if section.settings.hero_body != blank -%}
      <p class="about-hero__body fade-up" data-delay="4">{{ section.settings.hero_body }}</p>
    {%- endif -%}
  </div>
</div>

{%- comment -%}——— ORIGIN STORY ———{%- endcomment -%}
<div class="about-story full-width">
  <div class="about-story__inner">

    <div class="about-story__text">
      {%- if section.settings.story_eyebrow != blank -%}
        <span class="eyebrow about-story__eyebrow fade-up" data-delay="1">{{ section.settings.story_eyebrow }}</span>
      {%- endif -%}

      <h2 class="about-story__heading fade-up" data-delay="2">
        {{ section.settings.story_heading }}
        {%- if section.settings.story_heading_accent != blank -%}
          <span>{{ section.settings.story_heading_accent }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.story_body1 != blank -%}
        <p class="about-story__body fade-up" data-delay="3">{{ section.settings.story_body1 }}</p>
      {%- endif -%}

      {%- if section.settings.story_body2 != blank -%}
        <p class="about-story__body fade-up" data-delay="4">{{ section.settings.story_body2 }}</p>
      {%- endif -%}

      {%- if section.settings.story_founded != blank -%}
        <div class="about-story__founded fade-up" data-delay="5">
          <span class="about-story__founded-label">{{ 'sections.about.founded' | t }}</span>
          <span class="about-story__founded-year">{{ section.settings.story_founded }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="about-story__visual fade-up" data-delay="2">
      <div class="about-story__images">
        {%- if section.settings.story_image1 != blank -%}
          <div class="about-story__img about-story__img--back">
            {{
              section.settings.story_image1
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                alt: section.settings.story_image1.alt
            }}
          </div>
        {%- else -%}
          <div class="about-story__img about-story__img--back about-story__img--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}

        {%- if section.settings.story_image2 != blank -%}
          <div class="about-story__img about-story__img--front">
            {{
              section.settings.story_image2
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                alt: section.settings.story_image2.alt
            }}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{%- comment -%}——— VALUES ———{%- endcomment -%}
<div class="about-values full-width">
  <div class="about-values__inner">

    <div class="about-values__header">
      {%- if section.settings.values_eyebrow != blank -%}
        <span class="eyebrow about-values__eyebrow fade-up" data-delay="1">{{ section.settings.values_eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.values_heading != blank -%}
        <h2 class="about-values__heading fade-up" data-delay="2">{{ section.settings.values_heading }}</h2>
      {%- endif -%}
    </div>

    <div class="about-values__grid">
      {%- assign value_keys = '1,2,3' | split: ',' -%}
      {%- for k in value_keys -%}
        {%- assign vtitle_key = 'value_' | append: k | append: '_title' -%}
        {%- assign vbody_key  = 'value_' | append: k | append: '_body'  -%}
        {%- assign vtitle = section.settings[vtitle_key] -%}
        {%- assign vbody  = section.settings[vbody_key]  -%}
        {%- if vtitle != blank or vbody != blank -%}
          <div class="about-values__card fade-up" data-delay="{{ k }}">
            <span class="about-values__num">0{{ k }}</span>
            {%- if vtitle != blank -%}
              <h3 class="about-values__title">{{ vtitle }}</h3>
            {%- endif -%}
            {%- if vbody != blank -%}
              <p class="about-values__body">{{ vbody }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{%- comment -%}——— MISSION QUOTE ———{%- endcomment -%}
<div class="about-mission full-width">
  <div class="about-mission__grid-bg" aria-hidden="true"></div>
  <div class="about-mission__inner">
    <span class="divider-line about-mission__divider fade-up" data-delay="1" aria-hidden="true"></span>

    <blockquote class="about-mission__quote">
      {%- if section.settings.mission_ql1 != blank -%}
        <span class="about-mission__ql1 fade-up" data-delay="2">{{ section.settings.mission_ql1 }}</span>
      {%- endif -%}
      {%- if section.settings.mission_ql2 != blank -%}
        <span class="about-mission__ql2 fade-up" data-delay="3">{{ section.settings.mission_ql2 }}</span>
      {%- endif -%}
    </blockquote>

    {%- if section.settings.mission_body != blank -%}
      <p class="about-mission__body fade-up" data-delay="4">{{ section.settings.mission_body }}</p>
    {%- endif -%}

    <span class="divider-line about-mission__divider fade-up" data-delay="4" aria-hidden="true"></span>
  </div>
</div>

{%- comment -%}——— STATS ———{%- endcomment -%}
<div class="about-stats full-width">
  <div class="about-stats__inner">
    {%- assign stat_keys = '1,2,3,4' | split: ',' -%}
    {%- for k in stat_keys -%}
      {%- assign snum_key   = 'stat_' | append: k | append: '_number' -%}
      {%- assign slabel_key = 'stat_' | append: k | append: '_label'  -%}
      {%- assign snum   = section.settings[snum_key]   -%}
      {%- assign slabel = section.settings[slabel_key] -%}
      {%- if snum != blank or slabel != blank -%}
        <div class="about-stats__item fade-up" data-delay="{{ k }}">
          {%- if snum != blank -%}
            <span class="about-stats__number">{{ snum }}</span>
          {%- endif -%}
          {%- if slabel != blank -%}
            <span class="about-stats__label">{{ slabel }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- comment -%}——— CTA ———{%- endcomment -%}
{%- if section.settings.cta_heading != blank -%}
  <div class="about-cta full-width">
    <div class="about-cta__inner">
      {%- if section.settings.cta_eyebrow != blank -%}
        <span class="eyebrow about-cta__eyebrow fade-up" data-delay="1">{{ section.settings.cta_eyebrow }}</span>
      {%- endif -%}

      <h2 class="about-cta__heading fade-up" data-delay="2">{{ section.settings.cta_heading }}</h2>

      {%- if section.settings.cta_body != blank -%}
        <p class="about-cta__body fade-up" data-delay="3">{{ section.settings.cta_body }}</p>
      {%- endif -%}

      <div class="about-cta__buttons fade-up" data-delay="4">
        {%- if section.settings.cta_btn1_text != blank -%}
          <a href="{{ section.settings.cta_btn1_url | default: '#' }}" class="btn btn--primary">
            {{ section.settings.cta_btn1_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_btn2_text != blank -%}
          <a href="{{ section.settings.cta_btn2_url | default: '#' }}" class="btn btn--secondary">
            {{ section.settings.cta_btn2_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ═══════════════════════════════════
     HERO
  ═══════════════════════════════════ */
  .about-hero {
    position: relative;
    min-height: max(60vh, var(--about-hero-height, 600px));
    background-color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .about-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .about-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top,
        rgba(45, 58, 24, 0.45) 0%,
        rgba(45, 58, 24, 0.2) 50%,
        rgba(45, 58, 24, 0.28) 100%
      );
  }

  /* Retired with the tactical treatment; kept so existing markup stays valid */
  .about-hero__grid { display: none; }

  .about-hero__content {
    position: relative;
    z-index: 3;
    padding: clamp(60px, 8vh, 110px) clamp(24px, 5vw, 80px);
    max-width: 900px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-hero__eyebrow {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--about-hero-eyebrow, #ffffff);
    margin-bottom: 1.5rem;
  }

  .about-hero__headline {
    font-family: var(--font-heading);
    font-size: clamp(46px, 6.4vw, 92px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0.01em;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .about-hero__hl1 {
    color: var(--about-hero-hl1, #ffffff);
    display: block;
  }

  .about-hero__hl2 {
    color: var(--about-hero-hl2, #ffffff);
    display: block;
  }

  .about-hero__body {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 300;
    color: var(--about-hero-body, #5f6653);
    max-width: 520px;
    line-height: 1.65;
  }

  /* ═══════════════════════════════════
     ORIGIN STORY
  ═══════════════════════════════════ */
  .about-story {
    background-color: var(--about-story-bg, #f6f6f3);
    padding: 100px var(--page-margin);
  }

  .about-story__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .about-story__eyebrow {
    color: var(--about-story-eyebrow, #7a6634);
    display: block;
    margin-bottom: 1rem;
  }

  .about-story__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 4.5vw, 58px);
    line-height: 1.05;
    color: var(--about-story-hl, #2d3a18);
    margin-bottom: 1.75rem;
  }

  .about-story__heading span {
    color: var(--about-story-accent, #7a6634);
    display: block;
  }

  .about-story__body {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 300;
    color: var(--about-story-body, #5f6653);
    line-height: 1.75;
    margin-bottom: 1.25rem;
    max-width: 480px;
  }

  .about-story__body:last-of-type {
    margin-bottom: 2rem;
  }

  .about-story__founded {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
  }

  .about-story__founded-label {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(95, 102, 83, 0.55);
  }

  .about-story__founded-year {
    font-family: var(--font-heading);
    font-size: 32px;
    line-height: 1;
    color: var(--about-story-year, #7a6634);
  }

  .about-story__visual {
    position: relative;
  }

  .about-story__images {
    position: relative;
    height: 540px;
  }

  .about-story__img {
    position: absolute;
    overflow: hidden;
  }

  .about-story__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-story__img--back {
    top: 0;
    right: 0;
    width: 82%;
    height: 88%;
    z-index: 1;
  }

  .about-story__img--front {
    bottom: 0;
    left: 0;
    width: 52%;
    height: 56%;
    z-index: 2;
    border: 4px solid var(--about-story-bg, #f6f6f3);
  }

  .about-story__img--placeholder {
    background: var(--color-charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-story__img--placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.25;
    fill: var(--color-tan);
  }

  /* ═══════════════════════════════════
     VALUES
  ═══════════════════════════════════ */
  .about-values {
    background-color: var(--about-values-bg, #ffffff);
    padding: 100px var(--page-margin);
  }

  .about-values__inner {
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .about-values__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .about-values__eyebrow {
    display: block;
    margin-bottom: 1rem;
    color: var(--about-values-eyebrow, #7a6634);
  }

  .about-values__heading {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, 52px);
    color: var(--about-values-hl, #2d3a18);
    line-height: 1.05;
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .about-values__card {
    background-color: var(--about-values-card-bg, #f6f6f3);
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
    transition: background-color 0.2s ease;
  }

  .about-values__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-olive), transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .about-values__card:hover::before {
    opacity: 1;
  }

  .about-values__num {
    font-family: var(--font-heading);
    font-size: 64px;
    line-height: 1;
    color: var(--about-values-num, rgba(45, 58, 24, 0.35));
    display: block;
    margin-bottom: 20px;
    letter-spacing: 0.01em;
  }

  .about-values__title {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--about-values-title, #2d3a18);
    margin-bottom: 14px;
    line-height: 1.1;
  }

  .about-values__body {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: var(--about-values-body, #5f6653);
    line-height: 1.7;
  }

  /* ═══════════════════════════════════
     MISSION QUOTE
  ═══════════════════════════════════ */
  .about-mission {
    background-color: var(--about-mission-bg, #f2f1ea);
    position: relative;
    overflow: hidden;
    padding: 120px var(--page-margin);
  }

  .about-mission__grid-bg { display: none; }

  .about-mission__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 36px;
  }

  .about-mission__divider {
    background: var(--about-mission-divider, #7a6634);
  }

  .about-mission__quote {
    font-family: var(--font-heading);
    font-size: clamp(38px, 5.4vw, 72px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: 0.01em;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .about-mission__ql1 {
    color: var(--about-mission-ql1, #2d3a18);
    display: block;
  }

  .about-mission__ql2 {
    color: var(--about-mission-ql2, #2d3a18);
    display: block;
  }

  .about-mission__body {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 300;
    color: var(--about-mission-body, #5f6653);
    line-height: 1.7;
    max-width: 580px;
  }

  /* ═══════════════════════════════════
     STATS
  ═══════════════════════════════════ */
  .about-stats {
    background-color: var(--about-stats-bg, #f6f6f3);
    border-top: 1px solid rgba(45, 58, 24, 0.35);
    border-bottom: 1px solid rgba(45, 58, 24, 0.35);
    padding: 48px var(--page-margin);
  }

  .about-stats__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .about-stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 24px;
    gap: 8px;
  }

  .about-stats__item + .about-stats__item {
    border-left: 1px solid var(--about-stats-divider, var(--color-rule));
  }

  .about-stats__number {
    font-family: var(--font-heading);
    font-size: 44px;
    line-height: 1;
    color: var(--about-stats-number, #7a6634);
    letter-spacing: 0.01em;
  }

  .about-stats__label {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--about-stats-label, rgba(95, 102, 83, 0.6));
    max-width: 160px;
  }

  /* ═══════════════════════════════════
     CTA
  ═══════════════════════════════════ */
  .about-cta {
    background-color: var(--about-cta-bg, #ffffff);
    padding: 100px var(--page-margin);
  }

  .about-cta__inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .about-cta__eyebrow {
    color: var(--about-cta-eyebrow, #7a6634);
  }

  .about-cta__heading {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.0;
    color: var(--about-cta-hl, #2d3a18);
  }

  .about-cta__body {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 300;
    color: var(--about-cta-body, #5f6653);
    line-height: 1.7;
    max-width: 520px;
  }

  .about-cta__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 12px;
  }

  /* ═══════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════ */
  @media (max-width: 1024px) {
    .about-story__inner {
      grid-template-columns: 1fr;
      gap: 56px;
    }

    .about-story__images { height: 420px; }
    .about-story__body { max-width: 100%; }

    .about-values__grid {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  @media (max-width: 768px) {
    .about-story { padding: 72px var(--page-margin); }
    .about-values { padding: 72px var(--page-margin); }
    .about-mission { padding: 72px var(--page-margin); }
    .about-cta { padding: 72px var(--page-margin); }

    .about-story__images { height: 320px; }

    .about-stats__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 0;
    }

    .about-stats__item:nth-child(3) {
      border-left: none;
      border-top: 1px solid var(--about-stats-divider, var(--color-rule));
      padding-top: 32px;
    }

    .about-stats__item:nth-child(4) {
      border-top: 1px solid var(--about-stats-divider, var(--color-rule));
      padding-top: 32px;
    }

    .about-stats__number { font-size: 36px; }

    .about-mission__quote { font-size: clamp(34px, 9vw, 56px); }
  }
{% endstylesheet %}

