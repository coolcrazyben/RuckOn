      "label": "Success message",
      "default": "You're in. Welcome to the movement."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text (optional)",
      "default": "No spam. Unsubscribe anytime. We ruck, we don't spam."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f2f1ea"
    },
    {
      "type": "color",
      "id": "top_border_color",
      "label": "Top border color",
      "default": "#e3e3dc"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2d3a18"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#5f6653"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color",
      "default": "#2d3a18"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#2d3a18"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
