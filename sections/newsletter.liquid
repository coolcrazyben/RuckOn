{% style %}
  #shopify-section-{{ section.id }} .newsletter {
    --nl-bg:           {{ section.settings.background_color }};
    --nl-border:       {{ section.settings.top_border_color }};
    --nl-title:        {{ section.settings.title_color }};
    --nl-subtitle:     {{ section.settings.subtitle_color }};
    --nl-input-bg:     {{ section.settings.input_bg_color }};
    --nl-input-border: {{ section.settings.input_border_color }};
    --nl-btn-bg:       {{ section.settings.button_bg_color }};
    --nl-btn-text:     {{ section.settings.button_text_color }};
  }
{% endstyle %}

<div class="newsletter full-width">
  <div class="newsletter__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="newsletter__title fade-up" data-delay="1">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="newsletter__subtitle fade-up" data-delay="2">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="newsletter__form-wrap fade-up" data-delay="3">
      {%- form 'customer', id: 'newsletter-form', class: 'newsletter__form' -%}
        {{ form.errors | default_errors }}

        {%- if form.posted_successfully? -%}
          <p class="newsletter__success">
            {{ section.settings.success_message }}
          </p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="newsletter__row">
            <label for="newsletter-email" class="visually-hidden">
              {{ section.settings.input_placeholder }}
            </label>
            <input
              type="email"
              id="newsletter-email"
              name="contact[email]"
              class="newsletter__input"
              placeholder="{{ section.settings.input_placeholder }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              aria-required="true"
              required
            >
            <button type="submit" class="newsletter__btn btn btn--primary">
              {{ section.settings.button_text }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="newsletter__disclaimer fade-up" data-delay="4">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .newsletter {
    background-color: var(--nl-bg, #f2f1ea);
    border-top: 1px solid var(--nl-border, #e3e3dc);
    padding: 104px var(--page-margin);
  }

  .newsletter__inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .newsletter__title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--nl-title, #2d3a18);
  }

  .newsletter__title em,
  .newsletter__title span { font-style: normal; color: var(--color-tan); }

  .newsletter__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--nl-subtitle, #5f6653);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .newsletter__form-wrap {
    width: 100%;
  }

  .newsletter__row {
    display: flex;
    gap: 0;
    width: 100%;
    align-items: stretch;
    border-bottom: 1px solid var(--nl-input-border, rgba(45, 58, 24, 0.3));
    transition: border-color 0.2s ease;
  }

  .newsletter__row:focus-within {
    border-bottom-color: var(--color-ink);
  }

  .newsletter__input {
    flex: 1;
    padding: 12px 2px;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 16px;
    outline: none;
    min-width: 0;
    border-radius: 0;
  }

  .newsletter__input::placeholder {
    color: rgba(45, 58, 24, 0.4);
  }

  .newsletter__btn {
    flex-shrink: 0;
    min-width: 0;
    background: transparent;
    color: var(--nl-btn-bg, #2d3a18);
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 12px 4px 12px 20px;
    border: none;
    cursor: pointer;
    border-radius: 0;
    transition: opacity 0.2s ease;
  }

  .newsletter__btn:hover { opacity: 0.65; }

  .newsletter__success {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding: 16px 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .newsletter__disclaimer {
    font-family: var(--font-body);
    font-size: 12px;
    color: rgba(45, 58, 24, 0.5);
    line-height: 1.5;
    margin-top: 8px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .newsletter { padding: 72px var(--page-margin); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ruck On. Stay Informed."
    },
    {
