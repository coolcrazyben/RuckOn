{% doc %}
  Renders <option> elements for the community selection dropdown.

  The first name in the list is the house club and is pre-selected, so a member
  who never touches the dropdown still joins a club rather than nothing.

  To add a community: append  |New Community Name  to the assign string below.
  To remove a community: delete that name (and its surrounding pipes) from the string.
  Names are rendered in the order they appear in the list.

  @param {string} [selected] - The currently selected community value (pre-selects that option)

  @example
  <select>
    {% render 'community-list', selected: 'CrossFit Gold' %}
  </select>
{% enddoc %}

{%- comment -%}
  ======================================================================
  COMMUNITY LIST — Edit below. One pipe ( | ) separates each community.
  ======================================================================
{%- endcomment -%}
{%- assign community_names = "Ruck On Club|CrossFit Gold|Iron Brotherhood|Alpha Company|Bravo Squad|Charlie Platoon|Delta Company|Echo Team|Foxtrot Unit|GORUCK Chicago|GORUCK Atlanta|GORUCK Austin|GORUCK Seattle|Ruck Nation" | split: "|" -%}

{%- for community in community_names -%}
  {%- liquid
    assign is_selected = false
    if selected == blank and forloop.first
      assign is_selected = true
    elsif selected == community
      assign is_selected = true
    endif
  -%}
  <option value="{{ community | escape }}"{% if is_selected %} selected{% endif %}>{{ community }}</option>
{%- endfor -%}
