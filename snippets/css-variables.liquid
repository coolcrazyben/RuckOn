{% style %}
  :root {
    /* === Ruck On Brand Colors ===
       Field palette on paper: olive green, dark-olive ink, worn tan. */

    /* Green family (primary — buttons, links, accents) */
    --color-green:       #4a5c2a;
    --color-green-deep:  #1f290f;
    --color-green-light: #6b7f3e;

    /* Ink family (type) */
    --color-ink:         #2d3a18;
    --color-ink-60:      #5f6653;

    /* Tan family (eyebrows, stroke links, dividers) */
    --color-tan:         #7a6634;
    --color-tan-light:   #c8a96e;

    /* Paper family (backgrounds) */
    --color-paper:       #ffffff;
    --color-paper-warm:  #f2f1ea;
    --color-paper-cool:  #f6f6f3;
    --color-rule:        #e3e3dc;

    /* --- Legacy aliases -------------------------------------------------
       Existing sections reference these names. They now resolve to the
       palette above, so the whole theme moves together. Note that the old
       --color-orange CTA colour now resolves to green: orange is retired. */
    --color-olive:       var(--color-green);
    --color-olive-dark:  var(--color-green-deep);
    --color-olive-light: var(--color-green-light);
    --color-cream:       var(--color-paper-warm);
    --color-black:       var(--color-paper);
    --color-charcoal:    var(--color-paper-cool);
    --color-white:       var(--color-ink);
    --color-orange:      var(--color-green);

    /* === Semantic Aliases === */
    --color-background: {{ settings.background_color | default: '#ffffff' }};
    --color-foreground: {{ settings.foreground_color | default: '#2d3a18' }};

    /* === Typography ===
       Condensed athletic caps for display and labels; a neutral grotesque
       for body copy. */
    --font-heading:  'Oswald', 'Arial Narrow', Arial, sans-serif;
    --font-label:    'Oswald', 'Arial Narrow', Arial, sans-serif;
    --font-body:     'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    --font-primary--family: var(--font-body);

    /* Oswald carries no width axis — kept so label rules stay valid. */
    --label-stretch: normal;

    /* === Layout === */
    --page-width:   {{ settings.max_page_width }};
    --page-margin:  {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* === Header Heights === */
    --announcement-bar-height: 36px;
    --nav-height:              72px;
    --header-total-height:     calc(var(--announcement-bar-height) + var(--nav-height));
  }
{% endstyle %}
