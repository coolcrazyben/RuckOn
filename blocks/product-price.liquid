{% doc %}
  Product price. Shows regular price, or compare-at + sale price with an
  optional sale badge. Updated live by the section JavaScript on variant change.
{% enddoc %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- if block.settings.default_highest_price -%}
  {%- assign current_variant = product.variants | sort: 'price' | last -%}
{%- endif -%}

<div class="product-info__price" id="product-price" {{ block.shopify_attributes }}>
  {%- if current_variant.compare_at_price > current_variant.price -%}
    <s class="product-price__compare">{{ current_variant.compare_at_price | money }}</s>
    <span class="product-price__sale">{{ current_variant.price | money }}</span>
    {%- if block.settings.sale_badge_text != blank -%}
      <span class="product-price__badge">{{ block.settings.sale_badge_text }}</span>
    {%- endif -%}
  {%- else -%}
    <span class="product-price__regular">{{ current_variant.price | money }}</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Price",
  "settings": [
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale badge label",
      "default": "Sale"
    },
    {
      "type": "checkbox",
      "id": "default_highest_price",
      "label": "Default to highest-priced variant",
      "info": "Show the most expensive variant's price on page load instead of the first available one.",
      "default": false
    }
  ],
  "presets": [{ "name": "Price" }]
}
{% endschema %}
