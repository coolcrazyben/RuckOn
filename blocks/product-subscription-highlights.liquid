{% doc %}
  "What You Get" checklist for subscription / membership products. Renders an
  optional heading + intro and up to six checklist items (title + optional
  sub-text), each with a check icon. Safe on any template — the block renders
  nothing unless at least one item title is filled in.

  @param block.settings.heading - Section heading above the list.
  @param block.settings.intro - Short intro paragraph.
  @param block.settings.item_{1-6}_title - Checklist item label.
  @param block.settings.item_{1-6}_note - Optional item sub-text.
{% enddoc %}

{%- assign has_items = false -%}
{%- for i in (1..6) -%}
  {%- assign key = 'item_' | append: i | append: '_title' -%}
  {%- if block.settings[key] != blank -%}
    {%- assign has_items = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_items -%}
  <div class="sub-highlights" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="sub-highlights__heading">{{ block.settings.heading }}</h3>
    {%- endif -%}

    {%- if block.settings.intro != blank -%}
      <p class="sub-highlights__intro">{{ block.settings.intro }}</p>
    {%- endif -%}

    <ul class="sub-highlights__list">
      {%- for i in (1..6) -%}
        {%- assign title_key = 'item_' | append: i | append: '_title' -%}
        {%- assign note_key = 'item_' | append: i | append: '_note' -%}
        {%- assign title = block.settings[title_key] -%}
        {%- assign note = block.settings[note_key] -%}
        {%- if title != blank -%}
          <li class="sub-highlights__item">
            <svg class="sub-highlights__check" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M8.2 13.4 5 10.2l1.4-1.4 1.8 1.8 5-5L14.6 7z" fill="currentColor"/>
              <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.5"/>
            </svg>
            <span class="sub-highlights__text">
              <span class="sub-highlights__title">{{ title }}</span>
              {%- if note != blank -%}
                <span class="sub-highlights__note">{{ note }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .sub-highlights {
    margin: 4px 0 8px;
    padding: 22px 24px;
    background: var(--color-charcoal, #f8f8f9);
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--color-orange, #857151);
  }

  .sub-highlights__heading {
    font-family: var(--font-heading, 'Black Ops One', cursive);
    font-size: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-white, #0a1e32);
    margin: 0 0 6px;
  }

  .sub-highlights__intro {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-tan-light, #5c6469);
    margin: 0 0 14px;
  }

  .sub-highlights__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sub-highlights__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .sub-highlights__check {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--color-tan, #9a825c);
  }

  .sub-highlights__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sub-highlights__title {
    font-family: var(--font-label, 'Barlow Condensed', sans-serif);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--color-white, #0a1e32);
  }

  .sub-highlights__note {
    font-family: var(--font-body, 'Barlow', sans-serif);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(92, 100, 105, 0.75);
  }
{% endstylesheet %}

