{% doc %}
  Shared membership benefits panel for subscription products.

  Renders the four core member benefits as a checklist, plus an optional
  "Everything above, plus —" band used by the club-founder product to show what
  it adds on top of the identical member benefits. Both subscription templates
  render this same block so the core benefit copy stays worded identically on
  every page; only the plus band differs.

  Renders nothing unless at least one checklist item title is filled in.

  Settings: "visibility" (and "visibility_tag") control when the block appears;
  "heading" and "intro" open the panel; "item_1..6_title" / "item_1..6_note" are
  the core benefits; "plus_label" and "plus_1..3_title" / "plus_1..3_note" are
  the optional extra band.
{% enddoc %}

{%- liquid
  assign show_block = false
  case block.settings.visibility
    when 'subscription'
      if product.selling_plan_groups.size > 0
        assign show_block = true
      endif
    when 'tagged'
      if block.settings.visibility_tag != blank and product.tags contains block.settings.visibility_tag
        assign show_block = true
      endif
    else
      assign show_block = true
  endcase

  assign has_items = false
  for i in (1..6)
    assign key = 'item_' | append: i | append: '_title'
    if block.settings[key] != blank
      assign has_items = true
      break
    endif
  endfor

  assign has_plus = false
  for i in (1..3)
    assign key = 'plus_' | append: i | append: '_title'
    if block.settings[key] != blank
      assign has_plus = true
      break
    endif
  endfor
-%}

{%- if show_block and has_items -%}
  <div class="sub-highlights" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="sub-highlights__heading">{{ block.settings.heading }}</h3>
    {%- endif -%}

    {%- if block.settings.intro != blank -%}
      <p class="sub-highlights__intro">{{ block.settings.intro }}</p>
    {%- endif -%}

    <ul class="sub-highlights__list">
      {%- for i in (1..6) -%}
        {%- assign title_key = 'item_' | append: i | append: '_title' -%}
        {%- assign note_key = 'item_' | append: i | append: '_note' -%}
        {%- assign title = block.settings[title_key] -%}
        {%- assign note = block.settings[note_key] -%}
        {%- if title != blank -%}
          <li class="sub-highlights__item">
            <svg class="sub-highlights__check" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.45"/>
              <path d="M8.2 13.4 5 10.2l1.4-1.4 1.8 1.8 5-5L14.6 7z" fill="currentColor"/>
            </svg>
            <span class="sub-highlights__text">
              <span class="sub-highlights__title">{{ title }}</span>
              {%- if note != blank -%}
                <span class="sub-highlights__note">{{ note }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if has_plus -%}
      <div class="sub-highlights__plus">
        {%- if block.settings.plus_label != blank -%}
          <span class="sub-highlights__plus-label">{{ block.settings.plus_label }}</span>
        {%- endif -%}

        <ul class="sub-highlights__list">
          {%- for i in (1..3) -%}
            {%- assign title_key = 'plus_' | append: i | append: '_title' -%}
            {%- assign note_key = 'plus_' | append: i | append: '_note' -%}
            {%- assign title = block.settings[title_key] -%}
            {%- assign note = block.settings[note_key] -%}
            {%- if title != blank -%}
              <li class="sub-highlights__item">
                <svg class="sub-highlights__check sub-highlights__check--plus" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                  <circle cx="10" cy="10" r="9" fill="currentColor"/>
                  <path d="M9.1 5.6h1.8v3.5h3.5v1.8h-3.5v3.5H9.1v-3.5H5.6V9.1h3.5z" fill="#ffffff"/>
                </svg>
                <span class="sub-highlights__text">
                  <span class="sub-highlights__title">{{ title }}</span>
                  {%- if note != blank -%}
                    <span class="sub-highlights__note">{{ note }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .sub-highlights {
    margin: 4px 0 8px;
    padding: 24px 26px;
    background: var(--color-paper-cool);
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--color-green);
  }

  .sub-highlights__heading {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .sub-highlights__intro {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-ink-60);
    margin: 0 0 16px;
  }

  .sub-highlights__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .sub-highlights__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .sub-highlights__check {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--color-green);
  }

  .sub-highlights__check--plus {
    color: var(--color-tan);
  }

  .sub-highlights__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sub-highlights__title {
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .sub-highlights__note {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-ink-60);
  }

  /* "Everything above, plus —" band */
  .sub-highlights__plus {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--color-rule);
  }

  .sub-highlights__plus-label {
    display: block;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-tan);
    margin-bottom: 14px;
  }
{% endstylesheet %}

{% schema %}
{
