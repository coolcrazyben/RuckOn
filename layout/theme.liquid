<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}

    {%- comment -%} Google Fonts: Playfair Display (display serif) + Archivo (extended grotesque) {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,100..125,300..700;1,100..125,300..700&family=Playfair+Display:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    >

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}

    {%- comment -%}
      Favicon — upload your image in Shopify admin:
      Online Store → Themes → Customize → Theme settings → Favicon
      Recommended size: 32×32px or 512×512px PNG
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    {%- comment -%} Own wrapper so the fixed-header CSS/JS targets a guaranteed element {%- endcomment -%}
    <div id="site-header-fixed">
      {% sections 'header-group' %}
    </div>

    {%- comment -%} Reserves space for the fixed header so content sits below it {%- endcomment -%}
    <div id="header-spacer" aria-hidden="true"></div>

    <main id="main-content">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'scroll-animations' %}
  </body>
</html>
